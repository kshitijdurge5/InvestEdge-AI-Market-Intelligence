class Stock {
  final String symbol;
  String name;
  double price;
  double change;
  double rsi;
  double technical;
  double fundamental;
  double momentum;
  double risk;
  double confidence;
  Signal signal;
  DateTime updated;

  Stock({
    required this.symbol,
    required this.name,
    required this.price,
    this.change = 0,
    this.rsi = 50,
    this.technical = 50,
    this.fundamental = 60,
    this.momentum = 50,
    this.risk = 50,
    this.signal = Signal.hold,
    this.confidence = 50,
    DateTime? updated,
  }) : updated = updated ?? DateTime.now();
}

class Holding {
  final String symbol;
  double qty;
  double avgPrice;
  Holding(this.symbol, this.qty, this.avgPrice);
}

class SignalEngine {
  static void update(Stock s, Random r) {
    s.change = (s.change * .85) + (r.nextDouble() - .54) * .9;
    s.price = max(.5, s.price * (1 + s.change / 10000));
    s.rsi = (s.rsi + (r.nextDouble() - .5) * 5).clamp(8, 92);
    s.momentum = (50 + s.change * 8 + (r.nextDouble() - .5) * 15).clamp(0, 100);
    s.technical = (50 + (50 - s.rsi) * .35 + s.momentum * .35).clamp(0, 100);
    s.fundamental = (45 + r.nextDouble() * 45).clamp(0, 100);
    s.risk = (55 - s.change.abs() * 5 + r.nextDouble() * 20).clamp(5, 95);
    final score =
        s.technical * .35 +
        s.fundamental * .30 +
        s.momentum * .20 +
        s.risk * .15;
    s.signal = score >= 68
        ? Signal.buy
        : score <= 43
        ? Signal.sell
        : Signal.hold;
    s.confidence = (50 + (score - 50).abs() * 1.25).clamp(50, 95);
    s.updated = DateTime.now();
  }
}

