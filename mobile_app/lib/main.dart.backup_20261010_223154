  Widget levels(Stock s) {
    final buy = s.signal == Signal.buy;
    final sell = s.signal == Signal.sell;
    final entryLow = buy
        ? s.price * .995
        : sell
        ? s.price * .985
        : s.price * .99;
    final entryHigh = buy
        ? s.price * 1.005
        : sell
        ? s.price * 1.015
        : s.price * 1.01;
    final target1 = buy
        ? s.price * 1.04
        : sell
        ? s.price * .96
        : s.price * 1.02;
    final target2 = buy
        ? s.price * 1.08
        : sell
        ? s.price * .92
        : s.price * 1.04;
    final stop = buy
        ? s.price * .965
        : sell
        ? s.price * 1.035
        : s.price * .97;

    return _card(
      Padding(
        padding: const EdgeInsets.all(18),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const Expanded(
                  child: Text(
                    'Trade Levels',
                    style: TextStyle(fontWeight: FontWeight.w900, fontSize: 18),
                  ),
                ),
                signalChip(s.signal),
              ],
            ),
            const SizedBox(height: 12),
            level(
              'Entry Zone',
              'â‚¹${entryLow.toStringAsFixed(2)} â€“ â‚¹${entryHigh.toStringAsFixed(2)}',
            ),
            level('Target 1', 'â‚¹${target1.toStringAsFixed(2)}'),
            level('Target 2', 'â‚¹${target2.toStringAsFixed(2)}'),
            level('Stop Loss', 'â‚¹${stop.toStringAsFixed(2)}'),
          ],
        ),
      ),
    );
  }

