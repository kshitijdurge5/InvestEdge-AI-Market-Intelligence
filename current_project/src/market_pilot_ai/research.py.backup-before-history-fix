import logging

from .fundamentals import FundamentalsClient
from .historical_data import HistoricalDataClient
from .market_data import MarketDataClient
from .news import NewsClient
from .news_sentiments import NewsSentimentAnalyzer
from .risk import RiskAnalyzer
from .scoring import ScoringEngine
from .technical_analysis import TechnicalAnalyzer
from .analysis import MarketAnalyzer


logger = logging.getLogger(__name__)


class ResearchEngine:
    """
    Coordinates all MarketPilot market-research components.

    Flow:

    Market Data
        ↓
    Market Analysis
        ↓
    Historical Data
        ↓
    Technical Analysis
        ↓
    Fundamentals
        ↓
    Risk
        ↓
    News + Sentiment
        ↓
    Deterministic Scoring
        ↓
    Unified Market Signal
        ↓
    Score Breakdown
    """

    def __init__(
        self,
        market_data_client=None,
        historical_data_client=None,
        fundamentals_client=None,
        news_client=None,
        sentiment_analyzer=None,
        scoring_engine=None,
    ):
        self.market_data_client = (
            market_data_client
            or MarketDataClient()
        )

        self.historical_data_client = (
            historical_data_client
            or HistoricalDataClient()
        )

        self.fundamentals_client = (
            fundamentals_client
            or FundamentalsClient()
        )

        self.news_client = (
            news_client
            or NewsClient()
        )

        self.sentiment_analyzer = (
            sentiment_analyzer
            or NewsSentimentAnalyzer()
        )

        self.scoring_engine = (
            scoring_engine
            or ScoringEngine()
        )

        self.technical_analyzer = (
            TechnicalAnalyzer()
        )

        self.risk_analyzer = (
            RiskAnalyzer()
        )

        self.market_analyzer = (
            MarketAnalyzer()
        )

    # =========================================================
    # MAIN RESEARCH PIPELINE
    # =========================================================

    def analyze(
        self,
        symbol: str,
    ) -> dict:
        """
        Run the complete MarketPilot research pipeline.

        Returns a structured research dictionary containing:

        - market data
        - market analysis
        - historical data
        - technical analysis
        - fundamentals
        - risk
        - news
        - sentiment
        - deterministic score
        - score breakdown
        - unified market signal
        - signal reconciliation
        """

        # -----------------------------------------------------
        # Normalize symbol
        # -----------------------------------------------------

        symbol = symbol.strip().upper()

        if not symbol:
            raise ValueError(
                "Stock symbol cannot be empty."
            )

        logger.info(
            "Starting research for %s",
            symbol,
        )

        # =====================================================
        # 1. CURRENT MARKET DATA
        # =====================================================

        market_data = (
            self.market_data_client.get_market_data(
                symbol
            )
        )

        market_data_dict = (
            market_data.model_dump()
            if hasattr(
                market_data,
                "model_dump",
            )
            else market_data
        )

        # =====================================================
        # 2. MARKET ANALYSIS
        # =====================================================

        market_analysis = (
            self.market_analyzer.analyze(
                market_data
            )
        )

        # =====================================================
        # 3. HISTORICAL DATA
        # =====================================================

        historical_data = (
            self.historical_data_client.get_recent_history(
                symbol=symbol,
                days=30,
            )
        )

        if not historical_data:
            raise ValueError(
                f"No historical data available for {symbol}"
            )

        logger.info(
            "Retrieved %s historical candles for %s",
            len(historical_data),
            symbol,
        )

        # =====================================================
        # 4. TECHNICAL ANALYSIS
        # =====================================================

        technical_analysis = (
            self.technical_analyzer.analyze_symbol(
                symbol=symbol,
                days=30,
                historical_data_client=(
                    self.historical_data_client
                ),
            )
        )

        # =====================================================
        # 5. RISK ANALYSIS
        # =====================================================

        risk_analysis = (
            self.risk_analyzer.analyze(
                technical_analysis
            )
        )

        # =====================================================
        # 6. FUNDAMENTALS
        # =====================================================

        fundamentals = (
            self.fundamentals_client.get_fundamentals(
                symbol
            )
        )

        # =====================================================
        # 7. NEWS
        # =====================================================

        news = (
            self.news_client.get_news(
                symbol
            )
        )

        # =====================================================
        # 8. NEWS SENTIMENT
        # =====================================================

        news_sentiment = (
            self.sentiment_analyzer.analyze(
                news
            )
        )

        # =====================================================
        # 9. DETERMINISTIC SCORING
        # =====================================================

        score_result = (
            self.scoring_engine.calculate_score(
                market_analysis=market_analysis,
                technical_analysis=technical_analysis,
                fundamentals=fundamentals,
                risk_analysis=risk_analysis,
                news_sentiment=news_sentiment,
            )
        )

        # =====================================================
        # 10. EXTRACT SCORE INFORMATION
        # =====================================================

        if isinstance(
            score_result,
            dict,
        ):

            score = score_result.get(
                "overall_score",
                score_result.get(
                    "score",
                    score_result,
                ),
            )

            score_breakdown = score_result.get(
                "score_breakdown",
                {},
            )

            unified_signal = score_result.get(
                "unified_signal"
            )

            signal_reconciliation = (
                score_result.get(
                    "signal_reconciliation",
                    {},
                )
            )

        else:

            # Backward-compatible fallback.
            score = score_result
            score_breakdown = {}
            unified_signal = None
            signal_reconciliation = {}

        # =====================================================
        # 11. FINAL RESEARCH RESULT
        # =====================================================

        research_result = {
            "symbol": symbol,

            # Current market data.
            "market_data": market_data_dict,

            # Current market snapshot analysis.
            "market_analysis": market_analysis,

            # Historical OHLCV.
            "historical_data": historical_data,

            # Technical indicators.
            "technical_analysis": technical_analysis,

            # Risk analysis.
            "risk_analysis": risk_analysis,

            # Fundamental information.
            "fundamentals": fundamentals,

            # News.
            "news": news,

            # News sentiment.
            "news_sentiment": news_sentiment,

            # Overall deterministic score.
            "score": score,

            # New transparent scoring architecture.
            "score_breakdown": score_breakdown,

            # New unified signal architecture.
            "unified_signal": unified_signal,

            "signal_reconciliation": (
                signal_reconciliation
            ),
        }

        logger.info(
            "Research completed for %s with score %s "
            "and unified signal %s",
            symbol,
            score,
            unified_signal,
        )

        return research_result