<script>

const params = new URLSearchParams(window.location.search);
let symbol = (params.get("symbol") || "RELIANCE").toUpperCase();

document.getElementById("symbolInput").value = symbol;

function goDashboard() {
    window.location.href = "/dashboard";
}

function esc(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

function number(value, decimals = 2) {
    const n = Number(value);
    if (!Number.isFinite(n)) return "—";
    return n.toLocaleString("en-IN", {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals
    });
}

function signalClass(value) {
    const text = String(value || "").toLowerCase();

    if (
        text.includes("positive") ||
        text.includes("bullish") ||
        text.includes("buy")
    ) return "green";

    if (
        text.includes("negative") ||
        text.includes("bearish") ||
        text.includes("sell")
    ) return "red";

    return "yellow";
}

function recommendation(score, unified) {

    const s = Number(score || 0);
    const signal = String(unified || "").toLowerCase();

    if (s >= 75 && signal.includes("positive")) {
        return ["BUY", "green"];
    }

    if (s <= 40 && signal.includes("negative")) {
        return ["SELL", "red"];
    }

    return ["HOLD", "yellow"];
}

function renderChart(history) {

    const svg = document.getElementById("chart");

    if (!history || history.length < 2) {
        svg.innerHTML =
            '<text x="50%" y="50%" text-anchor="middle" fill="#71839a">Historical chart unavailable</text>';
        return;
    }

    const closes = history
        .map(x => Number(x.close))
        .filter(Number.isFinite);

    if (closes.length < 2) {
        svg.innerHTML =
            '<text x="50%" y="50%" text-anchor="middle" fill="#71839a">Historical chart unavailable</text>';
        return;
    }

    const width = 1000;
    const height = 300;
    const pad = 30;

    const min = Math.min(...closes);
    const max = Math.max(...closes);
    const range = Math.max(max - min, 1);

    const points = closes.map((price, index) => {

        const x =
            pad +
            (index / (closes.length - 1)) *
            (width - pad * 2);

        const y =
            height -
            pad -
            ((price - min) / range) *
            (height - pad * 2);

        return `${x},${y}`;
    }).join(" ");

    svg.innerHTML = `
        <polyline
            points="${points}"
            fill="none"
            stroke="#22c55e"
            stroke-width="4"
            stroke-linecap="round"
            stroke-linejoin="round"
        />

        <text x="${pad}" y="24"
              fill="#7f91a8"
              font-size="12">
            ₹${number(max)}
        </text>

        <text x="${pad}" y="${height - 8}"
              fill="#7f91a8"
              font-size="12">
            ₹${number(min)}
        </text>
    `;
}

function render(data) {

