                        <span>EMA 20</span>
                        <strong>₹${number(technical.ema_20)}</strong>
                    </div>

                    <div class="metric">
                        <span>Volatility</span>
                        <strong>${number(technical.volatility)}%</strong>
                    </div>

                </div>
            </div>

        </section>

        <section class="panel chart-panel">
            <h2>Historical Price</h2>
            <svg id="chart"
                 viewBox="0 0 1000 300"
                 preserveAspectRatio="none"></svg>
        </section>

        <section class="section-grid">

            <div class="panel">
                <h2>Fundamental Snapshot</h2>

                <div class="metric-grid">

                    <div class="metric">
                        <span>P/E</span>
                        <strong>${number(fundamentals.pe)}</strong>
                    </div>

                    <div class="metric">
                        <span>P/B</span>
                        <strong>${number(fundamentals.pb)}</strong>
                    </div>

                    <div class="metric">
                        <span>ROE</span>
                        <strong>${number(fundamentals.roe)}%</strong>
                    </div>

                    <div class="metric">
                        <span>ROCE</span>
                        <strong>${number(fundamentals.roce)}%</strong>
                    </div>

                    <div class="metric">
                        <span>ROA</span>
                        <strong>${number(fundamentals.roa)}%</strong>
                    </div>

                    <div class="metric">
                        <span>EV / EBITDA</span>
                        <strong>${number(fundamentals.ev_ebitda)}</strong>
                    </div>

                </div>
            </div>

            <div class="panel">
                <h2>Score Breakdown</h2>

                <div class="signal-row">
                    <span>Market</span>
                    <strong>${number(breakdown.market?.score)}</strong>
                </div>

                <div class="signal-row">
                    <span>Technical</span>
                    <strong>${number(breakdown.technical?.score)}</strong>
                </div>

                <div class="signal-row">
                    <span>Fundamental</span>
                    <strong>${number(breakdown.fundamental?.score)}</strong>
                </div>

                <div class="signal-row">
                    <span>Risk</span>
                    <strong>${number(breakdown.risk?.score)}</strong>
                </div>

                <div class="signal-row">
                    <span>News</span>
                    <strong>${number(breakdown.news?.score)}</strong>
                </div>

            </div>

        </section>

        <section class="panel ai">
            <h2>✦ AI Research Insight</h2>
            <div>
                ${
                    esc(
                        data.ai_reasoning ||
                        "AI reasoning is not available."
                    )
                }
            </div>
        </section>

        <section class="panel" style="margin-top:18px;">
            <h2>Market News</h2>

            ${
