                    ${number(sentiment.articles_analyzed,0)} articles
                </div>
            </div>

        </section>

        <section class="section-grid">

            <div class="panel">
                <h2>Signal Intelligence</h2>

                <div class="signal-row">
                    <span>Market Direction</span>
                    <span class="badge ${signalClass(marketAnalysis.market_signal)}">
                        ${esc(marketAnalysis.market_signal || "—")}
                    </span>
                </div>

                <div class="signal-row">
                    <span>Technical Direction</span>
                    <span class="badge ${signalClass(marketAnalysis.technical_signal)}">
                        ${esc(marketAnalysis.technical_signal || technical.trend || "—")}
                    </span>
                </div>

                <div class="signal-row">
                    <span>Unified Signal</span>
                    <span class="badge ${signalClass(data.unified_signal)}">
                        ${esc(data.unified_signal || "—")}
                    </span>
                </div>

                <div class="signal-row">
                    <span>Signal Consistency</span>
                    <span class="badge ${signalClass(
                        data.signal_reconciliation?.signal_consistency
                    )}">
                        ${esc(
                            data.signal_reconciliation?.signal_consistency || "—"
                        )}
                    </span>
                </div>

            </div>

            <div class="panel">
                <h2>Technical Indicators</h2>

                <div class="metric-grid">

                    <div class="metric">
                        <span>RSI 14</span>
                        <strong>${number(technical.rsi_14,1)}</strong>
                    </div>

