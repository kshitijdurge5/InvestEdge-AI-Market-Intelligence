                                        : ""
                                }
                            </div>
                        </div>
                    `).join("")
                    : '<div class="card-small">No news available.</div>'
            }

        </section>

        <div class="disclaimer">
            <strong>Data status:</strong>
            This environment is currently using mock/synthetic market,
            historical and news data. BUY/HOLD/SELL is a research signal,
            not personalized financial advice. Live market data will be
            connected through the configured market-data provider later.
        </div>
    `;

    renderChart(data.historical_data || []);
}

async function loadResearch() {

    const input =
        document.getElementById("symbolInput");

    const value =
        input.value.trim().toUpperCase();

    if (!value) {
        return;
    }

    symbol = value;

    document.getElementById("content").innerHTML =
        '<div class="loading">Analysing ' +
        esc(symbol) +
        '...</div>';

    history.replaceState(
        null,
        "",
        "/research-ui?symbol=" +
        encodeURIComponent(symbol)
    );

    try {

        const response =
            await fetch(
                "/research?symbol=" +
                encodeURIComponent(symbol)
            );

        const data =
            await response.json();

        render(data);

    } catch (error) {

        document.getElementById("content").innerHTML =
            '<div class="error">' +
            'Unable to load research. Make sure the server is running.' +
            '</div>';
    }
}

loadResearch();

</script>
