  State<ResearchScreen> createState() => _ResearchScreenState();
}

class _ResearchScreenState extends State<ResearchScreen> {
  late final TextEditingController searchController;
  StockAnalysis? analysis;
  bool analysing = false;
  String? errorMessage;
  @override
  void initState() {
    super.initState();
    searchController = TextEditingController(text: widget.initialSymbol);
    analyseStock(widget.initialSymbol);
  }

  @override
  void dispose() {
    searchController.dispose();
    super.dispose();
  }

  Future<void> analyseStock(String symbol) async {
    final clean = symbol.trim().toUpperCase();
    if (clean.isEmpty) return;
    FocusManager.instance.primaryFocus?.unfocus();
    setState(() {
      analysing = true;
      errorMessage = null;
    });
    try {
      final json = await InvestEdgeApi.analyse(clean);
      final result = StockAnalysis.fromJson(json);
      if (!mounted) return;
      setState(() {
        analysis = result;
        analysing = false;
      });
    } catch (error) {
      if (!mounted) return;
      setState(() {
        analysing = false;
        errorMessage = error.toString().replaceFirst('Exception: ', '');
      });
    }
  }

  String money(double value) {
    return '₹${value.toStringAsFixed(2)}';
  }

  Color recommendationColor(String recommendation) {
    if (recommendation == 'BUY') {
      return green;
    }
    if (recommendation == 'SELL') {
      return red;
    }
    return orange;
  }

  Color trendColor(String trend) {
    if (trend == 'Bullish') {
      return green;
    }
    if (trend == 'Bearish') {
      return red;
    }
    return orange;
  }

  String updatedTime(String value) {
    if (value.isEmpty) return '--';
    try {
      final date = DateTime.parse(value).toLocal();
      final hour = date.hour.toString().padLeft(2, '0');
      final minute = date.minute.toString().padLeft(2, '0');
      final second = date.second.toString().padLeft(2, '0');
      return '$hour:$minute:$second';
    } catch (_) {
      return value;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Material(
      color: background,
      child: RefreshIndicator(
        onRefresh: () async {
          await analyseStock(searchController.text);
        },
        child: ListView(
          padding: const EdgeInsets.fromLTRB(18, 5, 18, 35),
          children: [
            _researchHeader(),
            const SizedBox(height: 15),
            _searchBox(),
            const SizedBox(height: 18),
            if (analysing)
              _loadingCard()
            else if (errorMessage != null)
              _errorCard()
            else if (analysis != null)
              _analysisContent(analysis!),
            if (analysis == null && !analysing && errorMessage == null)
              _emptyCard(),
          ],
        ),
      ),
    );
  }

  Widget _researchHeader() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'AI Market Research',
          style: TextStyle(
            fontSize: 26,
            fontWeight: FontWeight.w800,
            color: primaryGreen,
          ),
        ),
        const SizedBox(height: 5),
        const Text(
          'Live market intelligence powered by Upstox V3',
          style: TextStyle(color: greyText, fontSize: 13),
        ),
      ],
    );
  }

  Widget _searchBox() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 5),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: borderColor),
      ),
      child: Row(
        children: [
          const Icon(Icons.search, color: greyText),
          const SizedBox(width: 8),
          Expanded(
            child: TextField(
              controller: searchController,
              textCapitalization: TextCapitalization.characters,
              decoration: const InputDecoration(
                border: InputBorder.none,
                hintText: 'Search stock e.g. ICICIBANK',
              ),
              onSubmitted: analyseStock,
            ),
          ),
          analysing
              ? const Padding(
                  padding: EdgeInsets.all(8),
                  child: SizedBox(
                    width: 20,
                    height: 20,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  ),
                )
              : IconButton(
                  tooltip: 'Analyse',
                  onPressed: () {
                    analyseStock(searchController.text);
                  },
                  icon: const Icon(Icons.arrow_forward, color: primaryGreen),
                ),
        ],
      ),
    );
  }

  Widget _loadingCard() {
    return Container(
      padding: const EdgeInsets.all(30),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: borderColor),
      ),
      child: const Column(
        children: [
          CircularProgressIndicator(color: primaryGreen),
          SizedBox(height: 15),
          Text(
            'Fetching live market analysis...',
            style: TextStyle(fontWeight: FontWeight.w700),
          ),
          SizedBox(height: 5),
          Text(
            'Getting NSE data and technical indicators from Upstox V3',
            textAlign: TextAlign.center,
            style: TextStyle(color: greyText, fontSize: 12),
          ),
        ],
      ),
    );
  }

  Widget _errorCard() {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: lightRed,
        borderRadius: BorderRadius.circular(18),
        border: Border.all(color: Colors.red.shade100),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Row(
            children: [
              Icon(Icons.error_outline, color: red),
              SizedBox(width: 8),
              Text(
                'Analysis failed',
                style: TextStyle(fontWeight: FontWeight.w800, color: red),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            errorMessage ?? '',
            style: const TextStyle(color: darkText, fontSize: 13),
          ),
          const SizedBox(height: 12),
          FilledButton.icon(
            onPressed: () {
              analyseStock(searchController.text);
            },
            icon: const Icon(Icons.refresh),
            label: const Text('Try Again'),
            style: FilledButton.styleFrom(backgroundColor: red),
          ),
        ],
      ),
    );
  }

  Widget _emptyCard() {
    return Container(
      padding: const EdgeInsets.all(30),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(20),
      ),
      child: const Column(
        children: [
          Icon(Icons.auto_graph, size: 45, color: primaryGreen),
          SizedBox(height: 12),
          Text(
            'Search a stock to begin',
            style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800),
          ),
        ],
      ),
    );
  }

  Widget _analysisContent(StockAnalysis data) {
    final recColor = recommendationColor(data.recommendation);
    final trColor = trendColor(data.trend);
    final positive = data.changePercent >= 0;
    return Column(
      children: [
        _stockHero(data, recColor, trColor, positive),
        const SizedBox(height: 14),
        _signalCard(data, recColor),
        const SizedBox(height: 14),
        _scoreGrid(data),
        const SizedBox(height: 14),
        _indicatorCard(data),
        const SizedBox(height: 14),
        _levelsCard(data),
        const SizedBox(height: 14),
        _insightCard(data),
        const SizedBox(height: 14),
        _dataCard(data),
      ],
    );
  }

  Widget _stockHero(
    StockAnalysis data,
    Color recColor,
    Color trColor,
    bool positive,
  ) {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(22),
        border: Border.all(color: borderColor),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withValues(alpha: 0.035),
            blurRadius: 16,
            offset: const Offset(0, 5),
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Text(
                          data.symbol,
                          style: const TextStyle(
                            fontSize: 22,
                            fontWeight: FontWeight.w900,
                          ),
                        ),
                        const SizedBox(width: 8),
                        _badge('LIVE', green, lightGreen),
                      ],
                    ),
                    const SizedBox(height: 4),
                    Text(
                      data.company,
                      style: const TextStyle(color: greyText, fontSize: 12),
                    ),
                  ],
                ),
              ),
              IconButton(
                tooltip: 'Refresh',
                onPressed: analysing
                    ? null
                    : () {
                        analyseStock(data.symbol);
                      },
                icon: const Icon(Icons.refresh),
              ),
            ],
          ),
          const SizedBox(height: 15),
          Row(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(
                money(data.price),
                style: const TextStyle(
                  fontSize: 31,
                  fontWeight: FontWeight.w900,
                  color: primaryGreen,
                ),
              ),
              const SizedBox(width: 10),
              Padding(
                padding: const EdgeInsets.only(bottom: 5),
                child: Text(
                  '${positive ? '+' : ''}${data.change.toStringAsFixed(2)} '
                  '(${positive ? '+' : ''}${data.changePercent.toStringAsFixed(2)}%)',
                  style: TextStyle(
                    color: positive ? green : red,
                    fontWeight: FontWeight.w800,
                    fontSize: 13,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 5),
          Text(
            'NSE • ${data.provider} ${data.providerVersion}',
            style: const TextStyle(color: greyText, fontSize: 11),
          ),
          const SizedBox(height: 15),
          Row(
            children: [
              Expanded(child: _miniSignal('TREND', data.trend, trColor)),
              const SizedBox(width: 9),
              Expanded(
                child: _miniSignal('SIGNAL', data.recommendation, recColor),
              ),
              const SizedBox(width: 9),
              Expanded(
                child: _miniSignal(
                  'CONFIDENCE',
                  '${data.confidence.toStringAsFixed(1)}%',
                  blue,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _signalCard(StockAnalysis data, Color recColor) {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: recColor.withValues(alpha: 0.08),
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: recColor.withValues(alpha: 0.22)),
      ),
      child: Row(
        children: [
          Container(
            width: 58,
            height: 58,
            decoration: BoxDecoration(
              color: recColor,
              borderRadius: BorderRadius.circular(17),
            ),
            child: Icon(
              data.recommendation == 'BUY'
                  ? Icons.trending_up
                  : data.recommendation == 'SELL'
                  ? Icons.trending_down
                  : Icons.pause,
              color: Colors.white,
              size: 30,
            ),
          ),
          const SizedBox(width: 14),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  data.recommendation,
                  style: TextStyle(
                    color: recColor,
                    fontSize: 22,
                    fontWeight: FontWeight.w900,
                  ),
                ),
                const SizedBox(height: 3),
                Text(
                  'InvestEdge signal • ${data.overallScore.toStringAsFixed(1)}/100',
                  style: const TextStyle(fontWeight: FontWeight.w700),
                ),
              ],
            ),
          ),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              const Text(
                'CONFIDENCE',
                style: TextStyle(
                  color: greyText,
                  fontSize: 9,
                  fontWeight: FontWeight.w800,
                ),
              ),
              const SizedBox(height: 4),
              Text(
                '${data.confidence.toStringAsFixed(1)}%',
                style: TextStyle(
                  color: recColor,
                  fontSize: 19,
                  fontWeight: FontWeight.w900,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _scoreGrid(StockAnalysis data) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        const Text(
          'Market Score',
          style: TextStyle(fontSize: 18, fontWeight: FontWeight.w800),
        ),
        const SizedBox(height: 10),
        Row(
          children: [
            Expanded(child: _scoreCard('Technical', data.technical, blue)),
            const SizedBox(width: 10),
            Expanded(
              child: _scoreCard('Fundamental', data.fundamental, orange),
            ),
          ],
        ),
        const SizedBox(height: 10),
        Row(
          children: [
            Expanded(child: _scoreCard('Momentum', data.momentum, green)),
            const SizedBox(width: 10),
            Expanded(
              child: _scoreCard(
                'Risk',
                data.risk,
                data.risk >= 70
                    ? red
                    : data.risk >= 50
                    ? orange
                    : green,
              ),
            ),
          ],
        ),
      ],
    );
  }

  Widget _scoreCard(String title, double value, Color color) {
    return Container(
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(17),
        border: Border.all(color: borderColor),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: const TextStyle(
              color: greyText,
              fontSize: 11,
              fontWeight: FontWeight.w700,
            ),
          ),
          const SizedBox(height: 8),
          Text(
            '${value.toStringAsFixed(1)}/100',
            style: const TextStyle(fontSize: 19, fontWeight: FontWeight.w900),
          ),
          const SizedBox(height: 8),
          ClipRRect(
            borderRadius: BorderRadius.circular(10),
            child: LinearProgressIndicator(
              value: value / 100,
              minHeight: 6,
              backgroundColor: color.withValues(alpha: 0.12),
              color: color,
            ),
          ),
        ],
      ),
    );
  }

  Widget _indicatorCard(StockAnalysis data) {
    return _sectionCard(
      title: 'Technical Indicators',
      icon: Icons.analytics_outlined,
      child: Column(
        children: [
          Row(
            children: [
              Expanded(
                child: _indicator(
                  'RSI (14)',
                  data.rsi == null ? '--' : data.rsi!.toStringAsFixed(2),
                  data.rsi == null
                      ? greyText
                      : data.rsi! >= 70
                      ? red
                      : data.rsi! <= 30
                      ? orange
                      : green,
                ),
              ),
              Expanded(
                child: _indicator(
                  'SMA 20',
                  data.sma20 == null ? '--' : money(data.sma20!),
                  data.sma20 != null && data.price > data.sma20! ? green : red,
                ),
              ),
            ],
          ),
          const Divider(height: 24),
          Row(
            children: [
              Expanded(
                child: _indicator(
                  'SMA 50',
                  data.sma50 == null ? '--' : money(data.sma50!),
                  data.sma50 != null && data.price > data.sma50! ? green : red,
                ),
              ),
              Expanded(child: _indicator('Candles', '${data.candles}', blue)),
            ],
          ),
          const SizedBox(height: 12),
          Align(
            alignment: Alignment.centerLeft,
            child: Text(
              '${data.timeframe} • '
              '${data.candles} candles available',
              style: const TextStyle(color: greyText, fontSize: 11),
            ),
          ),
        ],
      ),
    );
  }

  Widget _indicator(String title, String value, Color color) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(title, style: const TextStyle(color: greyText, fontSize: 11)),
        const SizedBox(height: 5),
        Text(
          value,
          style: TextStyle(
            color: color,
            fontSize: 17,
            fontWeight: FontWeight.w900,
          ),
        ),
      ],
    );
  }

  Widget _levelsCard(StockAnalysis data) {
    return _sectionCard(
      title: 'Trade Levels',
      icon: Icons.track_changes,
      child: Column(
        children: [
          Row(
            children: [
              Expanded(
                child: _level(
                  'ENTRY ZONE',
                  '${money(data.entryLow)}\n– ${money(data.entryHigh)}',
                  blue,
                ),
              ),
              const SizedBox(width: 10),
              Expanded(child: _level('TARGET 1', money(data.target), green)),
            ],
          ),
          const SizedBox(height: 10),
          Row(
            children: [
              Expanded(child: _level('TARGET 2', money(data.target2), green)),
              const SizedBox(width: 10),
              Expanded(child: _level('STOP LOSS', money(data.stopLoss), red)),
            ],
          ),
          const SizedBox(height: 12),
          const Text(
            'Levels are analytical estimates generated by the current InvestEdge signal engine.',
            style: TextStyle(color: greyText, fontSize: 10, height: 1.35),
          ),
        ],
      ),
    );
  }

  Widget _level(String title, String value, Color color) {
    return Container(
      padding: const EdgeInsets.all(13),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.07),
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: color.withValues(alpha: 0.18)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: TextStyle(
              color: color,
              fontSize: 9,
              fontWeight: FontWeight.w900,
            ),
          ),
          const SizedBox(height: 6),
          Text(
            value,
            style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w900),
          ),
        ],
      ),
    );
  }

  Widget _insightCard(StockAnalysis data) {
    return _sectionCard(
      title: 'AI Market Insight',
      icon: Icons.auto_awesome,
      child: Text(
        data.insight,
        style: const TextStyle(color: darkText, fontSize: 13, height: 1.55),
      ),
    );
  }

  Widget _dataCard(StockAnalysis data) {
    return Container(
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: const Color(0xFFF1F3F0),
        borderRadius: BorderRadius.circular(16),
      ),
      child: Row(
        children: [
          const Icon(Icons.verified_outlined, color: green, size: 19),
          const SizedBox(width: 8),
          Expanded(
            child: Text(
              'LIVE • ${data.provider} ${data.providerVersion} • '
              'Updated ${updatedTime(data.lastUpdated)}',
              style: const TextStyle(
                color: greyText,
                fontSize: 10,
                fontWeight: FontWeight.w700,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _sectionCard({
    required String title,
    required IconData icon,
    required Widget child,
  }) {
    return Container(
      padding: const EdgeInsets.all(17),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(19),
        border: Border.all(color: borderColor),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icon, color: primaryGreen, size: 20),
              const SizedBox(width: 8),
              Text(
                title,
                style: const TextStyle(
                  fontSize: 16,
                  fontWeight: FontWeight.w800,
                ),
              ),
            ],
          ),
          const SizedBox(height: 14),
          child,
        ],
      ),
    );
  }

  Widget _miniSignal(String title, String value, Color color) {
    return Container(
      padding: const EdgeInsets.all(10),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.07),
        borderRadius: BorderRadius.circular(12),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: const TextStyle(
              color: greyText,
              fontSize: 8,
              fontWeight: FontWeight.w800,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            value,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: TextStyle(
              color: color,
              fontSize: 12,
              fontWeight: FontWeight.w900,
            ),
          ),
        ],
      ),
    );
  }

  Widget _badge(String text, Color textColor, Color backgroundColor) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 4),
      decoration: BoxDecoration(
        color: backgroundColor,
        borderRadius: BorderRadius.circular(7),
      ),
      child: Text(
        text,
        style: TextStyle(
          color: textColor,
          fontSize: 9,
          fontWeight: FontWeight.w900,
        ),
      ),
    );
  }
}

class WatchlistScreen extends StatelessWidget {
  const WatchlistScreen({super.key});
  static const List<String> symbols = [
    'RELIANCE',
    'TCS',
    'HDFCBANK',
    'ICICIBANK',
    'INFY',
    'ITC',
    'AXISBANK',
    'SBIN',
  ];
  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(18, 8, 18, 30),
      children: [
        const Text(
          'Watchlist',
          style: TextStyle(
            fontSize: 27,
            fontWeight: FontWeight.w900,
            color: primaryGreen,
          ),
        ),
        const SizedBox(height: 5),
        const Text(
          'Keep your important stocks one tap away from AI research.',
          style: TextStyle(color: greyText),
        ),
        const SizedBox(height: 18),
        ...symbols.map((symbol) => _watchlistCard(context, symbol)),
      ],
    );
  }

  Widget _watchlistCard(BuildContext context, String symbol) {
    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      child: Material(
        color: Colors.white,
        borderRadius: BorderRadius.circular(17),
        child: InkWell(
          borderRadius: BorderRadius.circular(17),
          onTap: () {
            Navigator.of(context).push(
              MaterialPageRoute(
                builder: (_) => ResearchScreen(initialSymbol: symbol),
              ),
            );
          },
          child: Container(
            padding: const EdgeInsets.all(15),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(17),
              border: Border.all(color: borderColor),
            ),
            child: Row(
              children: [
                Container(
                  width: 43,
                  height: 43,
                  alignment: Alignment.center,
                  decoration: BoxDecoration(
                    color: lightGreen,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: const Icon(Icons.show_chart, color: primaryGreen),
                ),
                const SizedBox(width: 13),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        symbol,
                        style: const TextStyle(
                          fontWeight: FontWeight.w900,
                          fontSize: 15,
                        ),
                      ),
                      const SizedBox(height: 4),
                      const Text(
                        'Open AI analysis',
                        style: TextStyle(color: greyText, fontSize: 11),
                      ),
                    ],
                  ),
                ),
                const Icon(Icons.chevron_right, color: greyText),
              ],
            ),
          ),
        ),
      ),
    );
  }
}

