                style: TextStyle(
                  color: Color(0xFF9BE0B7),
                  fontWeight: FontWeight.w800,
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 15),
        _portfolioCard(
          context,
          'Equity',
          '35%',
          Icons.show_chart,
          green,
          'Stocks and shares currently represent 35% of this sample portfolio.',
        ),
        _portfolioCard(
          context,
          'Mutual Funds',
          '30%',
          Icons.account_balance,
          blue,
          'Mutual funds represent 30% of this sample portfolio.',
        ),
        _portfolioCard(
          context,
          'Gold / ETFs',
          '20%',
          Icons.workspace_premium,
          orange,
          'Gold and ETFs represent 20% of this sample portfolio.',
        ),
        _portfolioCard(
          context,
          'Bonds',
          '10%',
          Icons.account_balance_wallet,
          const Color(0xFF7C61B8),
          'Bonds represent 10% of this sample portfolio.',
        ),
        _portfolioCard(
          context,
          'Cash',
          '5%',
          Icons.payments_outlined,
          greyText,
          'Cash represents 5% of this sample portfolio.',
        ),
      ],
    );
  }

  Widget _portfolioCard(
    BuildContext context,
    String title,
    String value,
    IconData icon,
    Color color,
    String description,
  ) {
    return InkWell(
      borderRadius: BorderRadius.circular(17),
      onTap: () {
        showDialog<void>(
          context: context,
          builder: (_) => AlertDialog(
            title: Row(
              children: [
                Icon(icon, color: color),
                const SizedBox(width: 10),
                Expanded(child: Text(title)),
              ],
            ),
            content: Text(description),
            actions: [
              TextButton(
                onPressed: () => Navigator.of(context).pop(),
                child: const Text('Close'),
              ),
            ],
          ),
        );
      },
      child: Container(
        margin: const EdgeInsets.only(bottom: 10),
        padding: const EdgeInsets.all(15),
        decoration: BoxDecoration(
          color: Colors.white,
          borderRadius: BorderRadius.circular(17),
          border: Border.all(color: borderColor),
        ),
        child: Row(
          children: [
            Container(
              width: 42,
              height: 42,
              decoration: BoxDecoration(
                color: color.withValues(alpha: 0.1),
                borderRadius: BorderRadius.circular(12),
              ),
              child: Icon(icon, color: color),
            ),
            const SizedBox(width: 12),
            Expanded(
              child: Text(
                title,
                style: const TextStyle(fontWeight: FontWeight.w800),
              ),
            ),
            Text(
              value,
              style: TextStyle(color: color, fontWeight: FontWeight.w900),
            ),
          ],
        ),
      ),
    );
  }
}

class AccountScreen extends StatelessWidget {
  const AccountScreen({super.key});
  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(18),
      children: [
        const Text(
          'Account',
          style: TextStyle(
            fontSize: 27,
            fontWeight: FontWeight.w900,
            color: primaryGreen,
          ),
        ),
        const SizedBox(height: 18),
        Container(
          padding: const EdgeInsets.all(18),
          decoration: BoxDecoration(
            color: Colors.white,
            borderRadius: BorderRadius.circular(20),
            border: Border.all(color: borderColor),
          ),
          child: const Row(
            children: [
              CircleAvatar(
                radius: 28,
                backgroundColor: primaryGreen,
                child: Text(
                  'K',
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 21,
                    fontWeight: FontWeight.w900,
                  ),
                ),
              ),
              SizedBox(width: 13),
              Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'InvestEdge User',
                    style: TextStyle(fontSize: 17, fontWeight: FontWeight.w800),
                  ),
                  SizedBox(height: 3),
                  Text(
                    'AI Market Intelligence',
                    style: TextStyle(color: greyText, fontSize: 12),
                  ),
                ],
              ),
            ],
          ),
        ),
        const SizedBox(height: 15),
        _accountItem(
          context,
          Icons.security_outlined,
          'Account Security',
          () => _showAccountSecurity(context),
        ),
        _accountItem(
          context,
          Icons.notifications_none,
          'Notifications',
          () => _showNotifications(context),
        ),
        _accountItem(
          context,
          Icons.settings_outlined,
          'Settings',
          () => _showSettings(context),
        ),
        _accountItem(
          context,
          Icons.help_outline,
          'Help & Support',
          () => _showHelp(context),
        ),
        _accountItem(
          context,
          Icons.info_outline,
          'About InvestEdge',
          () => _showAbout(context),
        ),
      ],
    );
  }

  Widget _accountItem(
    BuildContext context,
    IconData icon,
    String title,
    VoidCallback onTap,
  ) {
    return Container(
      margin: const EdgeInsets.only(bottom: 9),
      child: Material(
        color: Colors.white,
        borderRadius: BorderRadius.circular(16),
        child: InkWell(
          borderRadius: BorderRadius.circular(16),
          onTap: onTap,
          child: Container(
            padding: const EdgeInsets.all(15),
            decoration: BoxDecoration(
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: borderColor),
            ),
            child: Row(
              children: [
                Icon(icon, color: primaryGreen),
                const SizedBox(width: 13),
                Expanded(
                  child: Text(
                    title,
                    style: const TextStyle(fontWeight: FontWeight.w700),
                  ),
                ),
                const Icon(Icons.chevron_right, color: greyText),
              ],
            ),
          ),
        ),
      ),
    );
  }

  void _showAccountSecurity(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Account Security'),
        content: const Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            ListTile(
              contentPadding: EdgeInsets.zero,
              leading: Icon(Icons.lock_outline),
              title: Text('Password'),
              subtitle: Text('Password protection is enabled.'),
            ),
            ListTile(
              contentPadding: EdgeInsets.zero,
              leading: Icon(Icons.verified_user_outlined),
              title: Text('Security status'),
              subtitle: Text('Your account security is active.'),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  void _showNotifications(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Notifications'),
        content: const Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            ListTile(
              contentPadding: EdgeInsets.zero,
              leading: Icon(Icons.trending_up),
              title: Text('Market alerts'),
              subtitle: Text('Receive important market movements.'),
            ),
            ListTile(
              contentPadding: EdgeInsets.zero,
              leading: Icon(Icons.notifications_active_outlined),
              title: Text('AI signals'),
              subtitle: Text('Get notified about Buy, Hold and Sell signals.'),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  void _showSettings(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Settings'),
        content: const Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            SwitchListTile.adaptive(
              contentPadding: EdgeInsets.zero,
              value: true,
              onChanged: null,
              title: Text('Live market data'),
              subtitle: Text('Use live market information when available.'),
            ),
            SwitchListTile.adaptive(
              contentPadding: EdgeInsets.zero,
              value: true,
              onChanged: null,
              title: Text('AI insights'),
              subtitle: Text('Show InvestEdge analysis and signals.'),
            ),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  void _showHelp(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('Help & Support'),
        content: const Text(
          'InvestEdge helps you research markets, review risk and track a sample portfolio.\n\nFor support, check that the backend is running and that the market-data connection is available.',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }

  void _showAbout(BuildContext context) {
    showDialog<void>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('About InvestEdge'),
        content: const Text(
          'InvestEdge\n\nTrack. Analyse. Invest Smarter.\n\nAI-powered market research, risk intelligence and portfolio tracking in one workspace.\n\nVersion 1.0',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(context).pop(),
            child: const Text('Close'),
          ),
        ],
      ),
    );
  }
}
