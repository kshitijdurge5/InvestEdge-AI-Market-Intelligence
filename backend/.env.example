# MarketPilot / InvestEdge local environment
APP_ENV=development
APP_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Database
DATABASE_URL=sqlite:///./marketpilot.db

# Email / OTP provider (production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SMS OTP provider (production)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Upstox
# NEVER commit a real token to GitHub or a ZIP you share publicly.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
UPSTOX_ACCESS_TOKEN=YOUR_REAL_TOKEN_HERE

# AI
DEEPSEEK_API_KEY=
